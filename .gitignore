# ---------------------------------------------------------------------------
# 构建与发行产物
# ---------------------------------------------------------------------------
# PyInstaller 的输出目录。每次打包都会重建，25 MB 左右，不该进仓库。
build/
dist/
# PyInstaller 每次构建都会重写 .spec；真正的构建设置在 build_exe.bat 里，
# 提交一份过时的 spec 只会让人以为改了它就有用。
*.spec
# 打包好的发行压缩包如果落在项目里，也不要提交（正式包放 GitHub Releases）。
*.zip

# ---------------------------------------------------------------------------
# 不在公开发行范围内的实验
# ---------------------------------------------------------------------------
# C#/WPF 重写实验：功能未完成，不随主线发布，留在本地。
native/
# VIIPER 虚拟 DualSense 的试验启动器（命令行 --backend dualsense 仍可用，
# 但没有做进公开版本，避免让人以为这是受支持的功能）。
启动-DS5体感测试.bat

# ---------------------------------------------------------------------------
# 本机运行产生的状态与采样数据（每台机器都不一样，且含个人设备信息）
# ---------------------------------------------------------------------------
# 上一次运行的设置：灵敏度、三轴死区、转发模式。
settings.json
# 逐项核对导出的报告 —— 里面有手柄 MAC 地址、固件版本和出厂标定值。
verification_report.json
# 手柄读数的原始记录，同样是本机数据。
hardware_session.txt
ds4_frame.txt
# 体感/haptics 采样的原始二进制（单个文件就有 120 MB）。
*.bin
# 做过逐项核对才会产生的按键映射修正。
captured_mapping.json

# ---------------------------------------------------------------------------
# Python 缓存
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------------------
# 开发期的界面快照与调试日志
# ---------------------------------------------------------------------------
# 早期的界面实现，留着本地对照用，不属于当前源码。
gui_prev.py
gui_before_theme.py
# 旧界面截图（README 只用 docs/images/ 里那一张）。
gui_*.png
native_ui.png
*.log

# ---------------------------------------------------------------------------
# 编辑器与系统杂项
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
